#!/bin/sh
# Refuse a push that tools/pre_push.py can show would turn CI red: per-file
# puzzle checks on a data push, and on a code push ruff's bug rules, the
# scratch-copy check, test_ci_cache_deps.js and the test scripts of each
# changed file, within about 20 seconds. It says why when it refuses.
# stdin holds one "<local ref> <local sha> <remote ref> <remote sha>" per ref.
zero=0000000000000000000000000000000000000000
rc=0
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue
  if [ "$remote" = "$zero" ] || ! git cat-file -e "$remote^{commit}" 2>/dev/null; then
    remote=$(git merge-base "$local" origin/master 2>/dev/null) || continue
  fi
  python3 "$(git rev-parse --show-toplevel)/tools/pre_push.py" "$remote" "$local" || rc=1
done
exit $rc
