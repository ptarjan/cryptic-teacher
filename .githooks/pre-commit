#!/bin/sh
# Every worktree shares .git/config, so a user.* set there re-authors every
# job's commits; the identity comes from the global config alone.
if git config --file "$(git rev-parse --git-common-dir)/config" --get-regexp '^user\.' >/dev/null; then
  echo "pre-commit: .git/config sets user.* for every worktree; remove it: git config --remove-section user" >&2
  exit 1
fi
# A tracked file with no layout row fails CI; refuse the commit instead.
# Fix: python3 tools/build_readme.py --add-missing, then stage docs/LAYOUT.md
# and tools/build_readme.py.
python3 tools/build_readme.py --check-layout || exit 1
# An annotation quoting words its clue no longer holds fails the deploy's
# validate run and holds every deploy after it; refuse it here instead.
staged=$(git diff --cached --name-only --diff-filter=AM -- 'puzzles/*.json')
[ -z "$staged" ] || printf '%s\n' "$staged" | xargs python3 tools/puzzle_integrity.py --quotes || exit 1
# So does a definition `at` a clue rewrite left behind (18bf10d65a, 8cb5a7e0b2:
# puzzle_integrity never looks at offsets). Rewrite clue text through
# enumeration.rewrite_entry, which moves them; run the deploy's own check here.
[ -z "$staged" ] || printf '%s\n' "$staged" | xargs python3 tools/validate_annotations.py --deploy >/dev/null || {
  printf '%s\n' "$staged" | xargs python3 tools/validate_annotations.py --deploy | grep -E 'ERROR|FAIL' >&2; exit 1; }
# A renamed puzzle's old id 404s unless tools/data/renamed_ids.json has its row;
# refuse the commit instead. Fix: python3 tools/renamed_ids.py --stage. A
# worktree whose tools/ predates the map has nothing to check.
[ ! -f tools/renamed_ids.py ] || python3 tools/renamed_ids.py --check-staged || exit 1
# A deleted or renamed puzzle's rows in the per-puzzle tables (source_clue_wrong
# and the rest) name nothing and fail CI; refuse the commit instead. Fix:
# python3 tools/puzzle_rows.py retire <old id> [<new id>], then stage the tables.
[ ! -f tools/puzzle_rows.py ] || python3 tools/puzzle_rows.py --check-staged || exit 1
# A page-build module missing from SMOKE_DEPS in tools/ci_cache.js fails CI's
# tools/test_ci_cache_deps.js; refuse the commit instead. Fix: add the path it
# names to SMOKE_DEPS.
if git diff --cached --name-only -- 'tools/*' 'sync/*' 'vendor/*' '*.js' | grep . >/dev/null; then
  node tools/test_ci_cache_deps.js >/dev/null || exit 1
fi
