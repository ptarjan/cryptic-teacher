# json-keys driver. Where the driver is not registered git ignores the
# attribute and merges line by line.
tools/data/corroboration_ledger.json merge=json-keys
tools/data/source_answer_wrong.json merge=json-keys
tools/data/source_clue_wrong.json merge=json-keys
