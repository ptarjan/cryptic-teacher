# Log of the daily LaunchAgent run (tools/com.pt.cryptic-teacher.plist) — local only.
.update.log
puzzles/__pycache__/
tools/__pycache__/
__pycache__/

# Grid-filler word data: ~26MB of MIT-licensed lexicon fetched by
# tools/fetch_lexicon.sh, plus the two files derived from it. Reproducible in
# under a minute, so it is fetched rather than committed — see tools/data/README.md.
tools/data/*.js
tools/data/lexicon.tsv
tools/data/clueability.tsv

# Blind-grading packets built by tools/grade_clues.py. They quote 60 published
# newspaper clues out of the georgeho corpus, which carries no declared licence,
# so they stay local. Regenerate with the same --seed for identical packets.
tools/data/grading/
