A", "anagramOf": true}, {"clueFragment": "A blessing", "gives": "A BLESSING", "anagramOf": true}]}, "4-down": {"definitions": [{"text": "Decorated", "at": 0}]}, "5-down": {"definitions": [{"text": "Colour in drawing", "at": 0}]}, "6-down": {"type": ["charade"], "definitions": [{"text": "cosmonaut", "at": 19}]}, "7-down": {"definitions": [{"text": "train", "at": 19}]}, "8-down": {"type": ["charade"], "definitions": [{"text": "Island", "at": 45}]}, "9-across": {"definitions": [{"text": "gloom", "at": 39}], "blocks": [{"clueFragment": "Ignore", "gives": "DISCOUNT"}, {"clueFragment": "storm", "gives": "RAGE"}]}}}
