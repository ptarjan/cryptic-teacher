E"}]}, "24-across": {"definitions": [{"text": "Garden", "at": 0}]}, "25-across": {"type": ["charade"], "definitions": [{"text": "power", "at": 36}]}, "26-across": {"type": ["double_definition"], "definitions": [{"text": "Suits", "at": 0}, {"text": "ties", "at": 10}]}, "3-down": {"type": ["cryptic_definition"], "definitions": [{"text": "Final letter to the Corinthians", "at": 0}]}, "4-down": {"type": ["anagram", "container"], "definitions": [{"text": "set meal", "at": 42}], "blocks": [{"clueFragment": "Vintner", "gives": "VINTNER", "anagramOf": true}]}, "5-across": {"definitions": [{"text": "We shout", "at": 0}]}, "5-down": {"type": ["charade"], "definitions": [{"text": "Treasurer", "at": 0}]}, "6-down": {"type": ["charade", "reversal"], "definitions": [{"text": "Poison plant", "at": 0}]}, "7-down": {"type": ["anagram"], "definitions": [{"text": "Old king", "at": 0}], "blocks": [{"clueFragment": "with the hard edge", "gives": "WITH THE HARD EDGE", "anagramOf": true}]}, "8-down": {"type": ["reversal"], "definitions": [{"text": "painful", "at": 20}]}, "9-across": {"type": ["charade"], "definitions": [{"text": "vessel", "at": 25}], "blocks": [{"clueFragment": "service", "gives": "RN"}]}}}
