ce", "at": 0}]}, "24-across": {"definitions": [{"text": "Most warm", "at": 0}]}, "25-across": {"type": ["charade"], "definitions": [{"text": "European", "at": 14}]}, "3-down": {"type": ["charade"], "definitions": [{"text": "US state", "at": 30}], "blocks": [{"clueFragment": "Bridge", "gives": "CONNECT"}, {"clueFragment": "channel", "gives": "CUT"}]}, "4-down": {"type": ["charade", "anagram"], "definitions": [{"text": "Reckless", "at": 0}]}, "5-across": {"type": ["charade"], "definitions": [{"text": "Look", "at": 0}]}, "5-down": {"definitions": [{"text": "Weapon that can't be fired point-blank", "at": 0}]}, "6-down": {"type": ["charade", "reversal"], "definitions": [{"text": "Italian city", "at": 29}], "blocks": [{"clueFragment": "No change of scenery", "gives": "RUT"}]}, "7-down": {"definitions": [{"text": "clumsy", "at": 28}]}, "8-down": {"definitions": [{"text": "data display", "at": 33}], "blocks": [{"clueFragment": "due to a", "gives": "DUE TO A", "anagramOf": true}]}, "9-across": {"definitions": [{"text": "Empty", "at": 0}]}}}
