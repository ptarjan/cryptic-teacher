  },
  {
   "number": 10,
   "direction": "across",
   "position": {
    "x": 8,
    "y": 2
   },
   "length": 7,
   "clue": {
    "text": "The London maid gets grand before the queen–and that's how the knights got around!",
    "enumeration": "7"
   }
  },
  {
   "number": 11,
   "direction": "across",
   "position": {
    "x": 0,
    "y": 4
   },
   "length": 3,
   "clue": {
    "text": "You would be surprised to meet another driver headed for you here.",
