  },
  {
   "number": 12,
   "direction": "across",
   "position": {
    "x": 4,
    "y": 4
   },
   "length": 6,
   "clue": {
    "text": "With a lot of money, as some say, the young fellow could get mixed up with the abridged Oxford English Dictionary.",
    "enumeration": "6"
   }
  },
  {
   "number": 13,
   "direction": "across",
   "position": {
    "x": 11,
    "y": 4
   },
   "length": 4,
   "clue": {
    "text": "Someone like Huey entertaining himself at the Victrola with these?",
