  {
   "number": 2,
   "direction": "down",
   "position": {
    "x": 2,
    "y": 0
   },
   "length": 7,
   "clue": {
    "text": "Do toadies show an absence of something important? Yes, possibly at last!",
    "enumeration": "7"
   }
  },
  {
   "number": 3,
   "direction": "down",
   "position": {
    "x": 4,
    "y": 0
   },
   "length": 10,
   "clue": {
    "text": "How the captain of the Pinafore swore!",
    "enumeration": "6,4",
    "separators": [
     {
      "at": 6,
      "mark": ","
     }
    ]
   }
  },
  {
   "number": 4,
   "direction": "down",
   "position": {
    "x": 6,
    "y": 0
   },
   "length": 8,
   "clue": {
    "text": "Raises the little pies, just like obnoxious newcomers!",
    "enumeration": "8"
   }
  },
  {
   "number": 5,
   "direction": "down",
   "position": {
    "x": 8,
    "y": 0
   },
   "length": 6,
   "clue": {
    "text": "The final note to a list he had made short–with acid applied.",
    "enumeration": "6"
   }
  },
  {
   "number": 6,
   "direction": "across",
   "position": {
    "x": 10,
    "y": 0
   },
   "length": 5,
   "clue": {
    "text": "They were found upon the Swanee River, when they were old.",
    "enumeration": "5"
   }
  },
  {
   "number": 6,
   "direction": "down",
   "position": {
    "x": 10,
    "y": 0
   },
   "length": 4,
   "clue": {
    "text": "Squashes down where some people live, sent astray.",
    "enumeration": "8"
   },
   "group": [
    "6-down",
    "27-down"
   ]
  },
  {
   "number": 7,
   "direction": "down",
   "position": {
    "x": 12,
    "y": 0
   },
   "length": 7,
   "clue": {
    "text": "In Paris the guy who takes care of the horses has plenty of space to sit in.",
    "enumeration": "3-4",
    "separators": [
     {
      "at": 3,
      "mark": "-"
     }
    ]
   }
  },
  {
   "number": 8,
   "direction": "down",
   "position": {
    "x": 14,
    "y": 0
   },
   "length": 9,
   "clue": {
    "text": "Harems show the direction an old piece of cloth takes, to possibly soil the result.",
    "enumeration": "9"
   }
  },
  {
   "number": 9,
   "direction": "across",
   "position": {
    "x": 0,
    "y": 2
